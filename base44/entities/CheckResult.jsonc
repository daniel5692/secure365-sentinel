{
  "name": "CheckResult",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string"
    },
    "scan_job_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "check_id": {
      "type": "string",
      "description": "Reference to CheckDefinition check_id"
    },
    "check_title": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "informational"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "warning",
        "manual",
        "not_applicable",
        "error"
      ]
    },
    "evidence": {
      "type": "string",
      "description": "Evidence data collected during the check"
    },
    "evidence_masked": {
      "type": "string",
      "description": "Masked version of evidence for display"
    },
    "actual_value": {
      "type": "string",
      "description": "The actual configuration value found"
    },
    "expected_value": {
      "type": "string",
      "description": "The expected/secure configuration value"
    },
    "explanation_he": {
      "type": "string",
      "description": "Hebrew explanation of this specific finding"
    },
    "remediation_he": {
      "type": "string"
    },
    "why_it_matters_he": {
      "type": "string"
    },
    "validation_method_he": {
      "type": "string"
    },
    "benchmark_ref": {
      "type": "string"
    },
    "execution_time_ms": {
      "type": "number"
    },
    "error_message": {
      "type": "string"
    },
    "is_retriable": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "workspace_id",
    "scan_job_id",
    "check_id",
    "status"
  ]
}